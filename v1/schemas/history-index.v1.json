{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xdcoutpost.xyz/XDC_Open_Data/v1/schemas/history-index.v1.json",
  "title": "History file index",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL of the JSON Schema for this document.",
      "format": "uri"
    },
    "dataset": {
      "type": "string",
      "description": "Dataset id."
    },
    "format": {
      "type": "string",
      "description": "File format."
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "UTC day (YYYY-MM-DD) or month (YYYY-MM).",
            "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
          },
          "csv": {
            "type": "string",
            "description": "The same day as CSV.",
            "format": "uri"
          },
          "url": {
            "type": "string",
            "description": "NDJSON file.",
            "format": "uri"
          },
          "lines": {
            "type": "integer",
            "description": "Records in the file."
          }
        }
      }
    }
  }
}
